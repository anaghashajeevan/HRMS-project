# # ===========================================================
# # HRMS Backend Environment Template
# # Copy this file to `.env` and update with your values
# # ===========================================================

# # ---------------- Django Core ----------------
# SECRET_KEY=your-secret-key-here
# DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# BACKEND_BASE_URL=http://127.0.0.1:8000

# # ---------------- CORS / CSRF ----------------
# CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# # ---------------- Database ----------------
# # Development: SQLite (Default)
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=
# DATABASE_PORT=

# # --- Production: PostgreSQL ---
# # DATABASE_ENGINE=django.db.backends.postgresql
# # DATABASE_NAME=your_database_name
# # DATABASE_USER=your_postgres_user
# # DATABASE_PASSWORD=your_postgres_password
# # DATABASE_HOST=postgres
# # DATABASE_PORT=5432



# ===========================================================
# HRMS Full Stack Environment Configuration (Template)
# Copy this file to .env and fill in real values.
# ===========================================================

# ---------------- Django Core ----------------
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,frontend
BACKEND_BASE_URL=http://localhost:8000

# ---------------- CORS / CSRF ----------------
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------- Database (PostgreSQL Server) ----------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=hrms_prod
DATABASE_USER=hrms_admin
DATABASE_PASSWORD=your_db_password_here
# Use 'host.docker.internal' if PostgreSQL is running on the host machine outside Docker
# Use 'postgres' if running in Docker, or an IP address if hosted externally
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432

# Encryption keys for PII fields (Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=your_fernet_key_here
CRYPTOGRAPHY_SALT=hrms-pii-production-salt-2026

# ==============================================================================
# EMAIL (SMTP Configuration)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=HRMS Notifications <your_email@gmail.com>
HR_NOTIFICATION_EMAIL=hr_notifications@yourdomain.com

# ==============================================================================
# CELERY + REDIS
# ==============================================================================
# Inside Docker Compose, use container name 'redis' (e.g. redis://redis:6379/0)
# Outside Docker, use localhost (e.g. redis://localhost:6379/0)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_EAGER=False

# ==============================================================================
# PORTAL URL & AI (GROQ)
# ==============================================================================
PORTAL_URL=http://localhost

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ==============================================================================
# COMPANY BRANDING
# ==============================================================================
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_TAGLINE=Excellence in Every Endeavor
COMPANY_ADDRESS=123 Business Park, City, State 123456
COMPANY_PHONE=+91 80 1234 5678
COMPANY_EMAIL=hr@yourcompany.com
COMPANY_WEBSITE=www.yourcompany.com
COMPANY_PRIMARY_COLOR=#1E40AF
COMPANY_ACCENT_COLOR=#3B82F6
COMPANY_LOGO_PATH=

# ==============================================================================
# REIMBURSEMENT APP SETTINGS
# ==============================================================================
TESSERACT_CMD=/usr/bin/tesseract
ALLOWED_RECIPIENT_DOMAINS=gmail.com,yourcompany.com
FINANCE_HEAD_EMAIL=finance_head@yourcompany.com
CTO_EMAIL=cto@yourcompany.com

QUICK_CLAIM_MAX_FILES=50
QUICK_CLAIM_MAX_FILE_SIZE=10485760
QUICK_CLAIM_UPLOAD_RATE=10/hour
QUICK_CLAIM_SEND_RATE=20/hour

# ==============================================================================
# ATTENDANCE & WHATSAPP GATEWAY
# ==============================================================================
ESSL_API_URL=http://192.168.1.19:85/iclock/webapiservice.asmx
ESSL_SERIAL_NUMBER=your_device_serial
ESSL_USERNAME=essl
ESSL_PASSWORD=essl

SHIFT_IN_TIME=09:30:00
SHIFT_OUT_TIME=19:00:00
DUPLICATE_SECONDS=60
AUTO_SEND_TIME=19:15

WHATSAPP_ENABLED=true
# Use host.docker.internal if WhatsApp Gateway runs on the host server on port 3005
WHATSAPP_GATEWAY_BASE_URL=http://host.docker.internal:3005
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_FALLBACK_PHONE=+919876543210